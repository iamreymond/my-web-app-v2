DB_HOST=localhost
DB_PORT=5432
DB_NAME=my_web_app_v2
DB_USER=postgres
DB_PASSWORD=your_local_postgres_password
PORT=3000

# Generate a private random value; do not use this placeholder.
SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters
# Configure these privately only when bootstrapping the first Admin.
BOOTSTRAP_ADMIN_NAME=Local Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=your_private_initial_admin_password
